# SYMBIO Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (leave blank or comment out to use embedded in-memory MongoDB automatically)
MONGO_URI=mongodb://127.0.0.1:27017/symbio

# LLM API Keys (optional - if omitted, domain-rich fallback heuristics will be used)
# Provide either Gemini or Claude key:
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
